# Aplikácia sa zostaví a beží aj bez premenných nižšie.
# DATABASE_URL do Vercelu zatiaľ nepridávajte.

# Voliteľné. Neon Postgres. Bez hodnoty sa aplikácia k databáze nepripája.
DATABASE_URL=

# Voliteľné. Verejná adresa webu pre SEO a neskôr pre odkazy v e-mailoch.
# Na Verceli sa dá nechať prázdne; lokálne stačí predvolená hodnota v kóde.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Voliteľné. Tajomstvo pre budúce prihlásenie administrátora (Auth.js).
AUTH_SECRET=

# Voliteľné. Prihlasovacie údaje administrátora. Použijú sa až po zapojení adminu.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Voliteľné. Adresa, na ktorú majú chodiť upozornenia zo štúdia.
NOTIFY_EMAIL=

# Voliteľné. Transakčné e-maily. Zatiaľ sa neodosielajú.
RESEND_API_KEY=
EMAIL_FROM="VIBRA <ahoj@vibra.studio>"

# Voliteľné. Časové pásmo štúdia pre dostupnosť a termíny.
STUDIO_TIMEZONE=Europe/Bratislava

# Voliteľné. Ak je nastavené, cron endpointy vyžadujú hlavičku Authorization: Bearer <hodnota>.
# Vercel ju pri plánovaných úlohách posiela automaticky.
CRON_SECRET=
