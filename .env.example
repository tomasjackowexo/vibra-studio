# Pripojenie na Neon Postgres.
# Aplikácia beží aj bez tejto premennej a k databáze sa nepripája.
DATABASE_URL=

# Verejná adresa webu. Použije sa v SEO a neskôr v odkazoch v e-mailoch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tajomstvo pre budúce prihlásenie administrátora.
AUTH_SECRET=

# Transakčné e-maily (potvrdenie rezervácie, zrušenie, newsletter). Zatiaľ sa nepoužívajú.
RESEND_API_KEY=
EMAIL_FROM="VIBRA <ahoj@vibra.studio>"

# Časové pásmo štúdia pre dostupnosť a termíny rezervácií.
STUDIO_TIMEZONE=Europe/Bratislava

# Tajomstvo pre budúce plánované úlohy (pripomienky, označenie neúčasti).
CRON_SECRET=
